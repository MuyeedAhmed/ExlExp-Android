# ==============================================================================
# ExlDroid Python Backend Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security / JWT Authentication
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_hex_string_32_bytes_or_more
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# ==============================================================================
# AWS Database (RDS / Aurora PostgreSQL) Configuration
# ==============================================================================
# OPTION A: Full connection URI (overrides individual parameters if provided)
# For AWS RDS PostgreSQL with asyncpg:
# DATABASE_URL=postgresql+asyncpg://postgres:YourMasterPassword@exldroid-db.cxxxx.us-east-1.rds.amazonaws.com:5432/exldroid?ssl=require

# OPTION B: Individual AWS RDS connection parameters:
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_DB_NAME=exldroid
AWS_RDS_USER=postgres
AWS_RDS_PASSWORD=
AWS_RDS_SSL_MODE=require

# OPTION C: Local SQLite fallback (default when AWS RDS variables are unset)
# SQLite fallback is automatic when AWS_RDS_HOST and DATABASE_URL are not configured:
# DATABASE_URL=sqlite+aiosqlite:///./exldroid.db

# ==============================================================================
# AWS Credentials & Region (Optional - used for AWS Secrets Manager or S3)
# ==============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SECRET_NAME=exldroid/db-credentials # If storing DB credentials in AWS Secrets Manager

# CORS Settings (comma-separated origins or * for open dev)
CORS_ORIGINS=*
